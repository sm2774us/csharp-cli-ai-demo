root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Google C# Style Guide: 2-space indentation, 100-column limit.
[*.cs]
indent_style = space
indent_size = 2
max_line_length = 100

# K&R / Egyptian brace style (Google diverges from the Microsoft
# Allman default: opening braces stay on the same line).
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# Braces required even for single-statement blocks (Google style).
csharp_prefer_braces = true:warning

# File-scoped namespaces (C# 10+): avoids an extra indent level for
# every type in the file, which is what caused the original mismatch
# between 2-space-indented members and a block-style namespace brace.
csharp_style_namespace_declarations = file_scoped:warning

# using directives outside namespace, System.* first.
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Naming: PascalCase for types/members, camelCase for locals/params,
# leading underscore is NOT used (Google C# style avoids it).
dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.members_pascal_case.severity = warning
dotnet_naming_rule.members_pascal_case.symbols = members
dotnet_naming_rule.members_pascal_case.style = pascal_case
dotnet_naming_symbols.members.applicable_kinds = method, property, event

dotnet_naming_rule.locals_camel_case.severity = suggestion
dotnet_naming_rule.locals_camel_case.symbols = locals
dotnet_naming_rule.locals_camel_case.style = camel_case
dotnet_naming_symbols.locals.applicable_kinds = local, parameter
dotnet_naming_style.camel_case.capitalization = camel_case

[*.{yml,yaml,json,md}]
indent_size = 2
